# Base URL of the DrainGuard FastAPI backend.
# Leave empty to use the Vite dev proxy (/api -> http://127.0.0.1:8000).
VITE_API_BASE=

# Poll interval for live telemetry, in milliseconds.
# The device reports at 1 Hz; polling faster than that only wastes requests.
VITE_POLL_MS=2000

# Seconds without a fresh sample before the UI marks data STALE.
VITE_STALE_AFTER_S=10

# Seconds without a fresh sample before the UI marks the device OFFLINE.
VITE_OFFLINE_AFTER_S=30
